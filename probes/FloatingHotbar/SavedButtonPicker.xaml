<Window x:Class="TeamBar.SavedButtonPicker"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Add saved button" Width="760" Height="580" MinWidth="620" MinHeight="450" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
 <Grid x:Name="PickerRoot" Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><Button Content="×" DockPanel.Dock="Right" Click="Close_Click" IsCancel="True" Padding="9,2" FontSize="22" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Close button picker"/><TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DockPanel>
  <Grid Grid.Row="1" Margin="0,0,0,16"><TextBox x:Name="Search" TextChanged="Search_Changed" Padding="12,9" AutomationProperties.Name="Search saved buttons"/><TextBlock x:Name="SearchHint" Text="Search saved buttons…" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" Margin="13,0" VerticalAlignment="Center"/></Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
   <Grid><ListBox x:Name="Choices" SelectionChanged="Selection_Changed" Background="{DynamicResource Surface}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Saved buttons" ItemContainerStyle="{DynamicResource GroupColumnRow}">
    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6"><TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Membership}" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox><TextBlock x:Name="Empty" Margin="16" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"/></Grid>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Details" Margin="0,0,8,0"/></ScrollViewer>
  </Grid>
  <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,18,0,0"><DockPanel>
   <Button x:Name="Add" DockPanel.Dock="Right" Content="Add button" Click="Add_Click" IsDefault="True" IsEnabled="False" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" Padding="18,10"/>
   <TextBlock Text="Uses the saved button. Its mappings stay shared." Foreground="{DynamicResource Muted}" Margin="0,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
  </DockPanel></Border>
 </Grid>
</Window>
