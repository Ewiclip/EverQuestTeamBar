<Window x:Class="TeamBar.DeleteConfirmation"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Confirm removal" Width="500" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Text}"
 FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
 <Border x:Name="DialogRoot" Padding="28" Background="{DynamicResource AppBackground}"><StackPanel>
  <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,18,0,14">
   <TextBlock x:Name="ItemName" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
  </Border>
  <TextBlock x:Name="Explanation" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,22"/>
  <ContentControl x:Name="SlideHost" HorizontalContentAlignment="Stretch"/>
  <TextBlock Text="Drag the handle all the way right, then release.&#x0a;Keyboard: Tab to the handle, hold →, then release." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,20"/>
  <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" HorizontalAlignment="Right" Padding="22,9" Click="Cancel_Click"/>
 </StackPanel></Border>
</Window>
