<UserControl x:Class="TeamBar.GameViewSlotRow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Foreground="{DynamicResource Text}">
 <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Padding="0,8,0,10">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel>
    <Button x:Name="Clear" Content="Clear" DockPanel.Dock="Right" MinHeight="24" Padding="6,1" ToolTip="Clear this slot" Style="{DynamicResource Quiet}"/>
    <TextBlock x:Name="Number" DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <TextBlock x:Name="Status" Style="{DynamicResource Hint}" VerticalAlignment="Center"/>
   </DockPanel>
   <Grid Grid.Row="1" Margin="0,4,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="Character" Style="{DynamicResource Hint}" Margin="0,0,0,3"/>
     <ComboBox x:Name="Character" IsEditable="True" IsTextSearchEnabled="False" MinHeight="36"/>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <TextBlock Text="EQ window" Style="{DynamicResource Hint}" Margin="0,0,0,3"/>
     <ComboBox x:Name="WindowPicker" MinHeight="36"/>
    </StackPanel>
   </Grid>
  </Grid>
 </Border>
</UserControl>
