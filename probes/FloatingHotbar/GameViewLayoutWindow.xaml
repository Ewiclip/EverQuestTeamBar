<Window x:Class="TeamBar.GameViewLayoutWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:TeamBar"
 Title="Team Bar · Window layouts" Width="780" Height="820" MinWidth="520" MinHeight="490"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Text}"
 FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
 <Grid Margin="24,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel>
   <TextBlock DockPanel.Dock="Left" Text="Window layouts" FontWeight="SemiBold" FontSize="24" VerticalAlignment="Center" Margin="0,0,16,0"/>
   <Button x:Name="NewLayout" DockPanel.Dock="Right" Content="New" Click="New_Click" Margin="8,0,0,0"/>
   <ComboBox x:Name="SavedLayouts" DisplayMemberPath="Name" AutomationProperties.Name="Saved layouts" ToolTip="Open a saved layout" SelectionChanged="Saved_Changed"/>
  </DockPanel>
  <Grid Grid.Row="1" Margin="0,15,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="Layout name" Margin="0,0,0,4"/>
    <TextBox x:Name="LayoutName" MaxLength="80" AutomationProperties.Name="Layout name"/>
   </StackPanel>
   <Button x:Name="IdentifyScreens" Grid.Column="1" Content="Identify screens" Click="IdentifyScreens_Click" VerticalAlignment="Bottom" Margin="8,0,0,0"
           ToolTip="Show the screen numbers on your connected monitors."/>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,12,0,8">
   <TextBlock Text="Select a screen" Margin="0,0,0,4"/>
   <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="5">
    <local:GameViewScreenMap x:Name="ScreenMap" Height="112" AutomationProperties.Name="Connected screens"/>
   </Border>
   <DockPanel x:Name="OfflinePanel" Margin="0,6,0,0" Visibility="Collapsed">
    <TextBlock Text="Disconnected screens" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ComboBox x:Name="OfflineScreens" AutomationProperties.Name="Disconnected screens" SelectionChanged="OfflineScreen_Changed"/>
   </DockPanel>
   <DockPanel Margin="0,8,0,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
   <RadioButton x:Name="DesignStep" Content="Layout" Style="{DynamicResource Mode}" Checked="Step_Changed"/>
   <RadioButton x:Name="AssignStep" Content="Slot assignments" Style="{DynamicResource Mode}" Checked="Step_Changed"/>
   </StackPanel>
    <TextBlock x:Name="EditingScreenTitle" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
  </StackPanel>
  <ScrollViewer x:Name="DesignPage" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,6,0">
    <StackPanel x:Name="ReplacementPanel" Visibility="Collapsed" Margin="0,0,0,10">
     <TextBlock Text="Move this screen’s slots to an unused monitor" Margin="0,0,0,4" TextWrapping="Wrap"/>
     <DockPanel>
      <Button x:Name="MoveToScreen" DockPanel.Dock="Right" Content="Move slots" Click="MoveToScreen_Click" Margin="8,0,0,0"/>
      <ComboBox x:Name="ReplacementScreen" AutomationProperties.Name="Replacement monitor"/>
     </DockPanel>
    </StackPanel>
    <StackPanel MaxWidth="230" HorizontalAlignment="Left">
      <TextBlock Text="Characters on this screen" Margin="0,0,0,4"/>
      <ComboBox x:Name="Capacity" AutomationProperties.Name="Characters on this screen" SelectionChanged="Capacity_Changed"/>
    </StackPanel>
    <TextBlock x:Name="EmptyScreenHint" Text="Choose a character count to set up this screen, or leave it at 0 to keep it free." Style="{DynamicResource Hint}" Margin="0,8,0,4"/>
    <StackPanel x:Name="SeatDesign">
    <Grid Margin="0,10,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Arrangement" Margin="0,0,0,4"/>
      <ComboBox x:Name="Arrangement" SelectionChanged="Arrangement_Changed" AutomationProperties.Name="Arrangement"/>
     </StackPanel>
     <StackPanel Grid.Column="2" x:Name="EdgeOptions" Visibility="Collapsed">
      <TextBlock Text="Preview strip edge" Margin="0,0,0,4"/>
      <ComboBox x:Name="Edge" SelectionChanged="Preview_Changed" AutomationProperties.Name="Preview strip edge"/>
     </StackPanel>
    </Grid>
    <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7"
            Height="172" Padding="8" Margin="0,14,0,8">
     <Viewbox Stretch="Uniform"><Canvas x:Name="Diagram" Background="{DynamicResource AppBackground}" ClipToBounds="True" AutomationProperties.Name="Layout preview"/></Viewbox>
    </Border>
    <Button x:Name="AssignSlots" Content="Assign characters →" HorizontalAlignment="Left" Margin="0,2,0,8" Click="Assign_Click"/>
    </StackPanel>
    <Border Height="1" Background="{DynamicResource Line}" Margin="0,6,0,10"/>
    <TextBlock Text="All screens" FontWeight="SemiBold" Margin="0,0,0,3"/>
    <WrapPanel Margin="-4,4,0,0">
     <CheckBox x:Name="SwapOnClick" Content="Enable Quick Swap" Style="{DynamicResource LayoutSwitch}" Margin="0,0,12,0" VerticalAlignment="Top"
               Checked="Swap_Changed" Unchecked="Swap_Changed" ToolTipService.ShowOnDisabled="True"/>
     <CheckBox x:Name="AddSwapButton" Content="Add Swap Button" Style="{DynamicResource LayoutSwitch}" Margin="0,0,12,0" VerticalAlignment="Top"
               Checked="Swap_Changed" Unchecked="Swap_Changed" ToolTip="Show a movable swap button in each occupied slot."/>
     <StackPanel>
      <CheckBox x:Name="MatchMasterResolution" Content="All screens match master resolution" HorizontalAlignment="Left" Style="{DynamicResource LayoutSwitch}">
       <CheckBox.ToolTip>
        <TextBlock MaxWidth="340" TextWrapping="Wrap" Text="Scale background views from the master resolution. Every assigned EQ window must use Windowed mode, including the master and previews."/>
       </CheckBox.ToolTip>
      </CheckBox>
      <TextBlock x:Name="MasterResolutionClickNotice" Style="{StaticResource MasterResolutionClickHint}"
                 DataContext="{Binding ElementName=SwapOnClick}"
                 MaxWidth="{Binding ActualWidth, ElementName=MatchMasterResolution}"
                 Visibility="{Binding IsChecked, ElementName=MatchMasterResolution, Converter={StaticResource ShowWhenChecked}}"/>
     </StackPanel>
    </WrapPanel>
    <TextBlock x:Name="SwapRedrawNotice" Margin="0,2,0,4">
     <TextBlock.Style>
      <Style TargetType="TextBlock" BasedOn="{StaticResource SwapRedrawHint}">
       <Style.Triggers>
        <MultiDataTrigger>
         <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsChecked, ElementName=SwapOnClick}" Value="True"/>
          <Condition Binding="{Binding IsChecked, ElementName=MatchMasterResolution}" Value="False"/>
         </MultiDataTrigger.Conditions>
         <Setter Property="Visibility" Value="Visible"/>
        </MultiDataTrigger>
        <MultiDataTrigger>
         <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsChecked, ElementName=AddSwapButton}" Value="True"/>
          <Condition Binding="{Binding IsChecked, ElementName=MatchMasterResolution}" Value="False"/>
         </MultiDataTrigger.Conditions>
         <Setter Property="Visibility" Value="Visible"/>
        </MultiDataTrigger>
       </Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
    <local:GameViewSwapButtonAppearance x:Name="ButtonAppearance" Visibility="Collapsed" Margin="0,5,0,4"/>
    <Grid x:Name="MasterOptions" Visibility="Collapsed" Margin="0,2,0,6">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Destination screen" Margin="0,0,0,4"/><ComboBox x:Name="MasterScreen" DisplayMemberPath="Label" AutomationProperties.Name="Destination screen" SelectionChanged="MasterScreen_Changed"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Destination slot" Margin="0,0,0,4"/><ComboBox x:Name="MasterSeat" AutomationProperties.Name="Destination slot" SelectionChanged="Preview_Changed"/></StackPanel>
    </Grid>
    <TextBlock x:Name="SwapTargetHint" Text="Choose a destination screen and slot for swapping." Style="{DynamicResource Hint}" Visibility="Collapsed" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
    <Border Height="1" Background="{DynamicResource Line}" Margin="0,8,0,6"/>
    <WrapPanel Margin="-4,0,0,6">
     <CheckBox x:Name="HideTitleBars" Content="Hide Title Bars" Style="{DynamicResource LayoutSwitch}" Margin="0,0,12,0"
               ToolTip="Hide the Windows title bar in every slot. If EQ keeps its maximized frame, a thin strip covers the title bar to preserve your UI layout."/>
     <CheckBox x:Name="OverlapTaskbar" Content="Overlap Taskbar" Style="{DynamicResource LayoutSwitch}" Margin="0,0,12,0"
               ToolTip="Extend slots over the taskbar on each configured screen." Checked="Preview_Changed" Unchecked="Preview_Changed"/>
     <CheckBox x:Name="AlwaysOnTop" Content="Always on Top" Style="{DynamicResource LayoutSwitch}"
               ToolTip="Keep game windows above other apps. Team Bar overlays and settings stay accessible."/>
    </WrapPanel>
   </StackPanel>
  </ScrollViewer>
  <Grid x:Name="AssignmentsPage" Grid.Row="3" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,6">
    <Button x:Name="IdentifyButton" Content="Identify windows" DockPanel.Dock="Right" Click="Identify_Click"/>
    <TextBlock x:Name="WindowCount" VerticalAlignment="Center" FontWeight="SemiBold"/>
   </DockPanel>
   <TextBlock Grid.Row="1" Text="Choose a character for automatic matching, or pick an open EQ window. Empty slots stay available." Style="{DynamicResource Hint}" Margin="0,0,0,8"/>
   <TextBlock Grid.Row="2" x:Name="IdentifyStatus" Style="{DynamicResource Hint}" Visibility="Collapsed"/>
   <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SlotList" Margin="0,0,6,0"/></ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="4" Margin="0,10,0,0">
   <TextBlock x:Name="ActiveStatus" Style="{DynamicResource Hint}"/>
   <TextBlock x:Name="Feedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>
   <DockPanel Margin="0,8,0,0">
    <Button x:Name="EndLayout" Content="End layout" DockPanel.Dock="Left" Click="End_Click" ToolTip="You can also end the active layout from the Team Bar tray menu."/>
    <Button x:Name="ApplyLayoutButton" DockPanel.Dock="Right" Content="Apply layout" Click="Apply_Click" Style="{DynamicResource Primary}"/>
    <Button x:Name="SaveLayoutButton" DockPanel.Dock="Right" Content="Save" Click="Save_Click" Margin="0,0,8,0"/>
    <Border/>
   </DockPanel>
  </StackPanel>
 </Grid>
</Window>
