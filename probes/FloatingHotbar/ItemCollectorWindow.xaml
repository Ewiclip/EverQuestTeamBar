<Window x:Class="TeamBar.ItemCollectorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Team Bar · Data Collection" Width="1180" Height="850" MinWidth="1000" MinHeight="680"
 Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="14"
 WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="12,9"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="Item" Padding="{TemplateBinding Padding}" CornerRadius="4" Background="Transparent"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource SelectedOption}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="MaxDropDownHeight" Value="320"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"/>
     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path Margin="0,0,15,0" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5"/></Border></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter IsHitTestVisible="False" Margin="13,6,35,6" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
     <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
      <Border Background="{DynamicResource PopupSurface}" BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1" CornerRadius="8" Padding="5" Margin="0,4,0,4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
       <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource HoverBorder}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Padding" Value="18,10"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabShell" Background="{TemplateBinding Background}" CornerRadius="7,7,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,2" Margin="0,0,6,0"><ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabShell" Property="Background" Value="{DynamicResource SelectedSurface}"/><Setter TargetName="TabShell" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="RowBackground" Value="{DynamicResource Surface}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource Field}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedSurface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource ButtonSurface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Shell" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Shell" Background="Transparent" CornerRadius="7" Padding="12,10" Margin="0,2"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource SelectedSurface}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Shell" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="CollectorRoot" Background="{DynamicResource AppBackground}" Padding="24"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20">
   <Button x:Name="ContributionsControl" Content="Contributions" DockPanel.Dock="Right" Click="Contributions_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
   <Border DockPanel.Dock="Right" Background="{DynamicResource BrandSurface}" CornerRadius="8" Padding="12,7" VerticalAlignment="Center"><TextBlock x:Name="CollectorBrand" Text="TEAM BAR · LOCAL ONLY" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold"/></Border>
   <StackPanel><TextBlock Text="Data Collection" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Items, recipes, NPCs and item sources observed as you play." Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="10" Padding="16" Margin="0,0,0,14">
   <StackPanel>
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="PauseControl" Content="Pause reading" Click="Pause_Click" Margin="8,0"/>
     <Button x:Name="BaselineControl" Content="Inventory baseline" Click="Baseline_Click" IsEnabled="False"/>
     <Button x:Name="ExportControl" Content="Save snapshot" Click="Export_Click" Margin="8,0,0,0" IsEnabled="False"/>
    </StackPanel>
    <StackPanel><TextBlock Text="CHARACTER" Style="{StaticResource Hint}" FontSize="10" Margin="0,0,0,5"/>
     <DockPanel><Button x:Name="RefreshControl" Content="↻" DockPanel.Dock="Right" Click="Refresh_Click" Padding="10,5" Margin="8,0,0,0" ToolTip="Refresh the character list"/>
      <ComboBox x:Name="ClientChoice" MinHeight="34" MinWidth="200" MaxWidth="360" DisplayMemberPath="CollectorLabel" SelectionChanged="Client_Changed" AutomationProperties.Name="Character and channel to collect"/>
     </DockPanel>
    </StackPanel>
   </DockPanel>
   <Border x:Name="DiscoveryWarning" Visibility="Collapsed" Margin="0,12,0,0" Background="{DynamicResource WarningSurface}" CornerRadius="7" Padding="10,8">
    <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <TextBlock x:Name="DiscoveryWarningText" Foreground="{DynamicResource WarningText}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </ScrollViewer>
   </Border>
   </StackPanel>
  </Border>
  <Border Grid.Row="2" Background="{DynamicResource PreviewSurface}" BorderBrush="{DynamicResource PreviewBorder}" BorderThickness="1" CornerRadius="9" Padding="14,10" Margin="0,0,0,14">
   <StackPanel><TextBlock x:Name="Counts" Text="Waiting for a client…" FontWeight="SemiBold"/><TextBlock x:Name="ComparisonHint" Text="The first successful reading becomes your comparison baseline." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
    <TextBlock x:Name="SourceState" Text="Read-only collection · Selected character" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
    <TextBlock x:Name="CapabilityNotice" TextWrapping="Wrap" Foreground="{DynamicResource WarningText}" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"/>
   </StackPanel>
  </Border>
  <TabControl x:Name="DataTabs" Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0,10,0,0" SelectionChanged="Tab_Changed">

   <TabItem x:Name="InventoryTab" Header="Inventory" IsSelected="True">
   <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="14">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBox x:Name="Search" TextChanged="Filter_Changed" Padding="12,9" Background="{DynamicResource Field}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}" AutomationProperties.Name="Search items by name or ID" ToolTip="Search by item name or ID"/>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12"><CheckBox x:Name="ChangesOnly" Content="Changes only" Foreground="{DynamicResource Text}" Checked="Filter_Changed" Unchecked="Filter_Changed"/><CheckBox x:Name="TradeskillOnly" Content="Tradeskill flag" Foreground="{DynamicResource Text}" Margin="20,0,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/></StackPanel>
     <ListBox x:Name="ItemList" Grid.Row="2" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Item_Changed" VirtualizingPanel.IsVirtualizing="True">
      <ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><TextBlock Text="{Binding ChangeLabel}" Foreground="{DynamicResource Accent}" DockPanel.Dock="Right" FontSize="11" Margin="8,0,0,0"/><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Text="{Binding Meta}" Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </Border>
   <Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="10" Padding="20">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock x:Name="ItemTitle" Text="Select an item" FontSize="21" FontWeight="SemiBold"/>
     <TextBlock x:Name="ItemSubtitle" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
     <TextBlock x:Name="ItemLocations" Margin="0,14,0,0" FontSize="12"/>
     <Border Background="{DynamicResource WarningSurface}" CornerRadius="7" Padding="11" Margin="0,16"><TextBlock Text="Property values are candidates for review against the game’s item display. Locations are separate item instances, not stack quantities." Foreground="{DynamicResource WarningText}" FontSize="12"/></Border>
     <ItemsControl x:Name="Properties"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Style="{StaticResource Hint}" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer>
   </Border>
   </Grid>
   </TabItem>
   <TabItem x:Name="InspectedTab" Header="Inspected Items">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBox x:Name="InspectionSearch" TextChanged="InspectionFilter_Changed" Padding="12,9" Margin="0,0,0,10" Background="{DynamicResource Field}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}" AutomationProperties.Name="Filter inspected items" ToolTip="Filter inspected items by name or ID"/>
      <ListBox x:Name="InspectionList" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="Inspection_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"><Run Text="Item "/><Run Text="{Binding ItemId, Mode=OneWay}"/><Run Text=" · Last seen "/><Run Text="{Binding LastSeen, Mode=OneWay}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     </Grid></Border>
     <Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="10" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="InspectionTitle" Text="Open an item link in EverQuest" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock x:Name="InspectionMeta" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
      <Border Background="{DynamicResource WarningSurface}" CornerRadius="7" Padding="11" Margin="0,16"><TextBlock Text="Includes items you do not own. Property values need item-display review. Closed item windows may retain cached records." Foreground="{DynamicResource WarningText}" FontSize="12"/></Border>
      <ItemsControl x:Name="InspectionProperties"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Style="{StaticResource Hint}" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></ScrollViewer></Border>
    </Grid>
   </TabItem>
   <TabItem x:Name="RecipesTab" Header="Recipes">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="14">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBox x:Name="RecipeSearch" TextChanged="RecipeFilter_Changed" Padding="12,9" Margin="0,0,0,10" Background="{DynamicResource Field}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}" AutomationProperties.Name="Filter recipes already loaded in the game" ToolTip="Filter recipes already loaded in the game. This does not search EverQuest."/>
       <ListBox x:Name="RecipeList" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Recipe_Changed">
        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Grid>
     </Border>
     <Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="10" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="RecipeTitle" Text="Search in EverQuest to load recipes" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock x:Name="RecipeMeta" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
      <Border Background="{DynamicResource WarningSurface}" CornerRadius="7" Padding="11" Margin="0,16"><TextBlock Text="Partial recipe data. Result item ID, yield and restrictions are not decoded. A search returns up to 100 visible records, not every recipe." Foreground="{DynamicResource WarningText}" FontSize="12"/></Border>
      <TextBlock x:Name="IngredientState" Text="Select a recipe in the game to load its ingredients. Selecting here only inspects data already read." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
      <ItemsControl x:Name="IngredientList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,10"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Hint}"><Run Text="Item "/><Run Text="{Binding ItemId, Mode=OneWay}"/><Run Text=" · Slot "/><Run Text="{Binding Slot, Mode=OneWay}"/><Run Text=" · Icon "/><Run Text="{Binding IconId, Mode=OneWay}"/></TextBlock></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="Each occupied ingredient slot is shown separately. Required quantities, output quantities and returned tools need further checks." Style="{StaticResource Hint}" Margin="0,16,0,0"/>
     </StackPanel></ScrollViewer></Border>
    </Grid>
   </TabItem>
   <TabItem x:Name="DropsTab" Header="NPC / Drops">
    <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="14"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12"><TextBlock Text="Observed loot sources" DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,24,0"/><TextBox x:Name="DropSearch" TextChanged="DropFilter_Changed" Padding="12,9" Background="{DynamicResource Field}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}" AutomationProperties.Name="Filter NPC drops by zone NPC or item" ToolTip="Filter by zone, NPC, item name or item ID"/></DockPanel>
     <DataGrid x:Name="DropList" Grid.Row="1" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="Drop_Changed">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Zone" Binding="{Binding ZoneLabel}" Width="1.05*"/>
       <DataGridTextColumn Header="NPC / Source" Binding="{Binding NpcName}" Width="1.4*"/>
       <DataGridTextColumn Header="Level" Binding="{Binding LevelLabel}" Width="78"/>
       <DataGridTextColumn Header="Drop" Binding="{Binding ItemName}" Width="1.55*"/>
       <DataGridTextColumn Header="Qty*" Binding="{Binding QuantityLabel}" Width="62"/>
       <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="92"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock x:Name="DropDetails" Grid.Row="2" Style="{StaticResource Hint}" Margin="0,12,0,0" Text="Loot entries appear here as the selected character receives them."/>
     <Border Grid.Row="3" Background="{DynamicResource PreviewSurface}" CornerRadius="7" Padding="12" Margin="0,12,0,0"><TextBlock Text="Zone and level require a matching loaded corpse. Unknown means that evidence was unavailable. Qty* is the largest stack observed, not a drop-rate statistic. Repeated reads do not add quantities." Style="{StaticResource Hint}"/></Border>
    </Grid></Border>
   </TabItem>
   <TabItem x:Name="MerchantsTab" Header="Merchants">
    <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="14"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,10"><TextBlock Text="Search" DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,14,0"/><TextBox x:Name="MerchantSearch" TextChanged="MerchantFilter_Changed" Padding="10,7" Background="{DynamicResource Field}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}" AutomationProperties.Name="Filter merchants by zone merchant or item" ToolTip="Filter by zone, merchant, item name or item ID"/></DockPanel>
     <Grid Grid.Row="1">
      <DataGrid x:Name="MerchantList" RowHeight="30" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="Merchant_Changed" AutomationProperties.Name="Observed unlimited merchant items">
       <DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="10,5"/></Style></DataGrid.CellStyle>
       <DataGrid.Columns>
        <DataGridTextColumn Header="Zone" Binding="{Binding ZoneLabel}" Width="1.1*"/>
        <DataGridTextColumn Header="Merchant" Binding="{Binding MerchantName}" Width="1.3*"/>
        <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="1.7*"/>
        <DataGridTextColumn Header="Item ID" Binding="{Binding ItemId}" Width="80"/>
        <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="90"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="MerchantEmpty" Text="No unlimited-stock items observed yet" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
     </Grid>
     <TextBlock x:Name="MerchantDetails" Grid.Row="2" Style="{StaticResource Hint}" Margin="0,12,0,0" Text="Open a merchant in EverQuest to collect its unlimited-stock items."/>
     <Border Grid.Row="3" Background="{DynamicResource PreviewSurface}" CornerRadius="7" Padding="12" Margin="0,12,0,0"><TextBlock Text="Only unlimited stock is collected. Observations stay here after closing the merchant; they do not prove a complete catalog. Save snapshot exports locally. Merchant sharing is not enabled." Style="{StaticResource Hint}"/></Border>
    </Grid></Border>
   </TabItem>
   <TabItem x:Name="GatheringTab" Header="Foraging / Fishing">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12"><Button Content="Choose character log…" DockPanel.Dock="Right" Click="ChooseGatheringLog_Click" Margin="12,0,0,0"/>
      <TextBlock x:Name="GatheringState" Text="Enable game logging with /log on. Only new successes in a verified Live zone are collected." Style="{StaticResource Hint}" VerticalAlignment="Center"/>
     </DockPanel>
     <DataGrid x:Name="GatheringList" Grid.Row="1" AutomationProperties.Name="Observed forage and fishing sources">
      <DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Source" Binding="{Binding Method}" Width="*"/>
       <DataGridTextColumn Header="Zone" Binding="{Binding ZoneName}" Width="2*"/><DataGridTextColumn Header="Last seen" Binding="{Binding Seen}" Width="*"/></DataGrid.Columns>
     </DataGrid>
    </Grid>
   </TabItem>
   <TabItem x:Name="TargetTab" Header="Target">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="22"><Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
      <TextBlock Text="SELECTED IN EVERQUEST" Style="{StaticResource Hint}" FontSize="11"/>
      <TextBlock x:Name="TargetTitle" Text="Waiting for a target reading" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,6"/>
      <TextBlock x:Name="MySpellSummary" Text="Your spells on this target" Style="{StaticResource Hint}"/>
      </StackPanel>
      <DockPanel Grid.Row="1" Margin="0,20,0,7"><TextBlock Text="REMAINING" Style="{StaticResource Hint}" FontSize="10" DockPanel.Dock="Right" Margin="10,0,12,0"/><TextBlock Text="YOUR SPELLS" Style="{StaticResource Hint}" FontSize="10" Margin="12,0,0,0"/></DockPanel>
      <Grid Grid.Row="2">
       <ListBox x:Name="MySpellList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Spells cast by the selected character" VirtualizingPanel.IsVirtualizing="True">
        <ListBox.ItemTemplate><DataTemplate><Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Border Background="{DynamicResource PreviewSurface}" CornerRadius="6" Width="40" Height="40" ClipToBounds="True">
          <Grid><TextBlock Text="✦" Foreground="{DynamicResource Accent}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Icon}" Stretch="Uniform" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
         </Border>
         <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="12,0,14,0" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
         <TextBlock Grid.Column="2" Text="{Binding Remaining}" FontFamily="Consolas" FontSize="16" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
        </Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock x:Name="MySpellEmpty" Text="Waiting for the first reading…" Style="{StaticResource Hint}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="400" Margin="20" IsHitTestVisible="False"/>
      </Grid>
      <TextBlock x:Name="MySpellNote" Grid.Row="3" Style="{StaticResource Hint}" Margin="0,16,0,0"/>
     </Grid></Border>
     <Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="10" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="Target details" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,20"/>
      <UniformGrid Columns="3" Margin="0,0,0,20">
       <StackPanel><TextBlock Text="TYPE" Style="{StaticResource Hint}" FontSize="10"/><TextBlock x:Name="TargetType" Text="—" FontSize="18" Foreground="{DynamicResource Accent}" Margin="0,6,0,0"/></StackPanel>
       <StackPanel><TextBlock Text="LEVEL" Style="{StaticResource Hint}" FontSize="10"/><TextBlock x:Name="TargetLevel" Text="—" FontSize="18" Margin="0,6,0,0"/></StackPanel>
       <StackPanel><TextBlock Text="SPAWN ID" Style="{StaticResource Hint}" FontSize="10"/><TextBlock x:Name="TargetSpawn" Text="—" FontSize="18" Margin="0,6,0,0"/></StackPanel>
      </UniformGrid>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,0"><StackPanel>
       <TextBlock Text="ZONE" Style="{StaticResource Hint}" FontSize="11"/>
       <TextBlock x:Name="TargetZone" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
       <TextBlock x:Name="TargetZoneDetail" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
      </StackPanel></Border>
      <Border Background="{DynamicResource PreviewSurface}" CornerRadius="8" Padding="14" Margin="0,20,0,12"><StackPanel><TextBlock Text="UPDATES EVERY 500 MS" Style="{StaticResource Hint}" FontSize="10" Margin="0,0,0,7"/><TextBlock x:Name="TargetTiming" Text="Waiting for the first successful read" FontSize="12"/></StackPanel></Border>
      <TextBlock Text="Pause reading freezes this view. Save snapshot keeps your spells and the current target." Style="{StaticResource Hint}"/>
     </StackPanel></ScrollViewer></Border>
    </Grid>
   </TabItem>
  </TabControl>
  <StackPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Text="Finding supported EverQuest clients…" Style="{StaticResource Hint}"/><TextBlock x:Name="SaveHint" Text="Supported target data: every 500 ms. Other supported data: every 2 seconds. Switching character or closing clears viewer history. No game input." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
   <DockPanel Margin="0,8,0,0"><Button x:Name="RetryContributionsControl" Content="Retry upload" DockPanel.Dock="Right" Click="RetryContributions_Click" Padding="10,5" Margin="12,0,0,0" IsEnabled="False"/><TextBlock x:Name="ContributionState" Text="Contributions are off. Collection stays on this computer." Style="{StaticResource Hint}" VerticalAlignment="Center"/></DockPanel>
  </StackPanel>
 </Grid></Border>
</Window>
