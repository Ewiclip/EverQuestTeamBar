<Window x:Class="TeamBar.SpellOverlayManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TeamBar"
 Title="Team Bar · Spell Overlays" Width="1250" Height="900" MinWidth="1020" MinHeight="720"
 Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13"
 WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SpellOverlayStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="CasterSegment" TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Segment" Background="Transparent" CornerRadius="5" BorderBrush="Transparent" BorderThickness="1" Padding="8,6"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource SelectedSurface}"/><Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SpellChoiceItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
   <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Shell" Background="Transparent" CornerRadius="5" Padding="8,4" Margin="0,1" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource SelectedSurface}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </ResourceDictionary></Window.Resources>
 <Border x:Name="OverlayReviewRoot" Background="{DynamicResource AppBackground}" Padding="24"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="HideOverlaysControl" Content="Hide overlays" Visibility="Collapsed" Click="Hide_Click" ToolTip="Hide the displays and stop their updates. Your saved bars stay available."/><Button x:Name="SaveButton" Content="Show overlays" Click="Save_Click" FontWeight="SemiBold"/></StackPanel>
   <StackPanel><TextBlock Text="Spell overlays" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Watch your target. See which spells are missing." Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="195"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="12"><DockPanel>
    <Button DockPanel.Dock="Bottom" Content="+ New overlay" Click="New_Click" Margin="0,12,0,0"/>
    <ListBox x:Name="OverlayList" SelectionChanged="Overlay_Changed" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding EditorName}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding CharacterPersona}" Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel>
     <Button Grid.Column="1" Content="×" Click="Delete_Click" Padding="6,2" Margin="4,0,0,0" FontSize="20" VerticalAlignment="Center" Background="Transparent" ToolTip="Delete this spell overlay…" AutomationProperties.Name="{Binding EditorName, StringFormat='Delete {0}'}"/>
    </Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel></Border>
   <Grid Grid.Column="2" x:Name="Editor"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Button x:Name="BarSettingsToggle" Content="›  Bar settings" Click="ToggleBarSettings_Click" HorizontalAlignment="Left" Margin="0,0,0,10" ToolTip="Show the selected bar's name, character, class, and position" AutomationProperties.Name="Expand bar settings"/>
    <Border Grid.Row="1" x:Name="BarSettingsPanel" Visibility="Collapsed" Background="{DynamicResource Surface}" CornerRadius="10" Padding="18" Margin="0,0,0,12"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="OVERLAY NAME (OPTIONAL)" Style="{StaticResource Hint}" FontSize="10" Margin="0,0,0,6"/><TextBox x:Name="OverlayName" MaxLength="60" TextChanged="Fields_Changed" AutomationProperties.Name="Overlay name (optional)"/></StackPanel>
      <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="CHARACTER" Style="{StaticResource Hint}" FontSize="10" Margin="0,0,0,6"/><DockPanel><Button DockPanel.Dock="Right" Content="↻" ToolTip="Refresh loaded characters" Click="Refresh_Click" Margin="6,0,0,0" Padding="7,5"/><ComboBox IsSynchronizedWithCurrentItem="False" x:Name="CharacterChoice" SelectionChanged="Fields_Changed" MinHeight="34" AutomationProperties.Name="Bar character"/></DockPanel></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="CLASS" Style="{StaticResource Hint}" FontSize="10" Margin="0,0,0,6"/><ComboBox IsSynchronizedWithCurrentItem="False" x:Name="ClassChoice" SelectionChanged="Fields_Changed" MinHeight="34" AutomationProperties.Name="Bar class"/></StackPanel>
      </Grid>
     </Grid>
     <CheckBox x:Name="OverlayEnabled" Content="Show this overlay" IsChecked="True" Checked="Fields_Changed" Unchecked="Fields_Changed" Margin="0,13,0,0"/>
     <TextBlock Text="Appears automatically when this character is playing this class. All spells in the bar use this persona." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
     <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="POSITION" Style="{StaticResource Hint}" FontSize="10" Margin="0,0,0,5"/><ComboBox x:Name="PlacementChoice" SelectionChanged="Placement_Changed" MinHeight="34" AutomationProperties.Name="Spell bar placement"/></StackPanel>
      <TextBlock Grid.Column="2" x:Name="PlacementHint" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
     </Grid>
    </StackPanel></Border>
    <Grid x:Name="SpellWorkspace" Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
     <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="14"><Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,10"><DockPanel><Button DockPanel.Dock="Right" Content="+ Add spells" Click="ShowAdd_Click" Padding="9,7" Margin="6,0,0,0"/><TextBlock Text="Watched spells" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Drag the grip to reorder within a section." Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel>
      <ListBox Grid.Row="1" x:Name="WatchList" Background="Transparent" BorderThickness="0" SelectionChanged="Watch_Changed" ItemContainerStyle="{StaticResource SpellChoiceItem}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="False"
               PreviewMouseLeftButtonDown="Watch_MouseDown" PreviewMouseMove="Watch_MouseMove" PreviewKeyDown="Watch_KeyDown"
               AllowDrop="True" DragOver="Watch_DragOver" Drop="Watch_Drop" DragLeave="Watch_DragLeave" AutomationProperties.Name="Spells grouped by NPC and Player">
       <ListBox.GroupStyle><GroupStyle HidesIfEmpty="False"><GroupStyle.HeaderTemplate><DataTemplate>
        <DockPanel Margin="4,12,4,7"><TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" Style="{StaticResource Hint}"/><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="14"/></DockPanel>
       </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
       <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Detail}"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="27"/></Grid.ColumnDefinitions>
        <Border Background="Transparent" Cursor="SizeNS" PreviewMouseLeftButtonDown="Grip_MouseDown" ToolTip="Drag to reorder. Alt + Up/Down also moves the selected spell." AutomationProperties.Name="Reorder spell"><TextBlock Text="⠿" FontSize="20" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <Image Grid.Column="1" Source="{Binding Image}" Width="26" Height="26" HorizontalAlignment="Left"/>
        <StackPanel Grid.Column="2" Margin="3,0,4,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
        <Button Grid.Column="3" Content="×" Tag="{Binding}" Click="RemoveSpell_Click" Padding="4,1" FontSize="18" VerticalAlignment="Center" Background="Transparent" ToolTip="Remove this spell" AutomationProperties.Name="Remove spell"/>
       </Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="2" x:Name="NoSpells" Text="Add a spell to either section to begin." Style="{StaticResource Hint}" Margin="4,10,4,0"/>
     </Grid></Border>
     <Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="10" Padding="16"><TabControl x:Name="SpellTabs" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}">
      <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True"/><ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0,14,0,0"/></Grid></ControlTemplate></TabControl.Template>
      <TabItem x:Name="ConfigureTab" Header="Configure spells"><Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <StackPanel Margin="0,0,0,12"><TextBlock x:Name="SelectedSpellName" Text="Select a spell" FontWeight="SemiBold" FontSize="18"/><TextBlock x:Name="SelectedSpellHint" Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Choose a spell from the list to configure it."/></StackPanel>
       <ScrollViewer Grid.Row="1" x:Name="ConfigureScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SelectedSpellSettings" Margin="0,0,8,0">
        <StackPanel Margin="0,0,0,14"><TextBlock Text="SPELL ALIAS" Style="{StaticResource Hint}" FontSize="10" Margin="0,0,0,5"/><TextBox x:Name="SpellAlias" MaxLength="80" TextChanged="Alias_Changed" AutomationProperties.Name="Spell alias"/><TextBlock Text="Optional name shown on the overlay. Leave blank to use the spell name." Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel>
        <Border Background="{DynamicResource Field}" CornerRadius="6" Padding="12"><StackPanel>
         <TextBlock Text="WHEN CLICKED" Style="{StaticResource Hint}" FontSize="10"/>
         <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Hold Key(s)" Style="{StaticResource Hint}" Margin="0,0,0,4"/><local:ModifierPicker x:Name="ClickModifierChoice" ValueChanged="ClickKey_Changed" MinHeight="34" AutomationProperties.Name="Modifiers to hold"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Click Key" Style="{StaticResource Hint}" Margin="0,0,0,4"/><ComboBox IsSynchronizedWithCurrentItem="False" x:Name="ClickKeyChoice" SelectionChanged="ClickKey_Changed" MinHeight="34" MaxDropDownHeight="320" IsTextSearchEnabled="True" AutomationProperties.Name="Key to send"/></StackPanel>
         </Grid><TextBlock x:Name="ClickKeyHint" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
        </StackPanel></Border>
        <Grid x:Name="RuleEditor" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="SECTION" Style="{StaticResource Hint}" FontSize="10" Margin="0,0,0,5"/><ComboBox IsSynchronizedWithCurrentItem="False" x:Name="TargetChoice" SelectionChanged="Rule_Changed" MinHeight="34"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="COUNTS AS PRESENT" Style="{StaticResource Hint}" FontSize="10" Margin="0,0,0,5"/><ComboBox IsSynchronizedWithCurrentItem="False" x:Name="CasterChoice" SelectionChanged="Rule_Changed" MinHeight="34"/></StackPanel>
         <CheckBox Grid.Row="1" Grid.ColumnSpan="3" x:Name="ShowMissing" Content="Show if missing" Checked="Rule_Changed" Unchecked="Rule_Changed" Margin="0,14,0,0"/>
        </Grid>
        <CheckBox x:Name="ExpandTriggered" Content="Track triggered effects automatically" Checked="Rule_Changed" Unchecked="Rule_Changed" Margin="0,14,0,0"/>
        <TextBlock x:Name="TriggeredHint" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
        <Border x:Name="AlternativeEditor" Background="{DynamicResource Field}" CornerRadius="6" Padding="12" Margin="0,16,0,0"><StackPanel>
         <DockPanel><Button DockPanel.Dock="Right" Content="+ Add" Click="ShowAdd_Click" Padding="8,5" Margin="6,0,0,0" ToolTip="Choose an alternative in Add spells"/><TextBlock Text="Also counts as present" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
         <TextBlock Text="Any one of these spells prevents the missing alert. All ranks count. Clicking still sends your configured key." Style="{StaticResource Hint}" Margin="0,7,0,8"/>
         <ListBox x:Name="AlternativeList" Background="Transparent" BorderThickness="0" MaxHeight="168" ItemContainerStyle="{StaticResource SpellChoiceItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Alternative spells"><ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Label}"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="27"/></Grid.ColumnDefinitions><Image Source="{Binding Image}" Width="26" Height="26" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="2" Content="×" Tag="{Binding Id}" Click="RemoveAlternative_Click" Padding="4,1" FontSize="18" Background="Transparent" ToolTip="Remove this alternative" AutomationProperties.Name="Remove alternative"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
         <TextBlock x:Name="NoAlternatives" Text="Use + Add to choose an alternative spell." Style="{StaticResource Hint}"/>
        </StackPanel></Border>
       </StackPanel></ScrollViewer>
      </Grid></TabItem>
      <TabItem x:Name="AddTab" Header="Add spells"><ScrollViewer x:Name="AddScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="SpellPicker" MinHeight="440" Height="{Binding ViewportHeight, ElementName=AddScroll}" Margin="0,0,4,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox IsSynchronizedWithCurrentItem="False" x:Name="SpellSourceChoice" SelectionChanged="Source_Changed" MinHeight="34" AutomationProperties.Name="Spell source"/><Button Grid.Column="1" x:Name="ReadTargetButton" Content="Read target" Click="CurrentTarget_Click" Padding="9,7" Margin="8,0,0,0"/></Grid>
        <Border x:Name="CasterFilterPanel" Visibility="Collapsed" Background="{DynamicResource Field}" CornerRadius="7" Padding="4" Margin="0,10,0,0"><UniformGrid Columns="3">
         <RadioButton x:Name="FilterMine" GroupName="TargetCaster" Content="Mine" IsChecked="True" Checked="CasterFilter_Changed" Style="{StaticResource CasterSegment}" ToolTip="Spells cast by this bar's character"/>
         <RadioButton x:Name="FilterOthers" GroupName="TargetCaster" Content="Others" Checked="CasterFilter_Changed" Style="{StaticResource CasterSegment}" ToolTip="Spells with a known caster other than this character"/>
         <RadioButton x:Name="FilterAll" GroupName="TargetCaster" Content="All" Checked="CasterFilter_Changed" Style="{StaticResource CasterSegment}" ToolTip="All effects, including those with an unknown caster"/>
        </UniformGrid></Border>
        <TextBox x:Name="SpellSearch" TextChanged="Search_Changed" ToolTip="Filter by spell name or ID" AutomationProperties.Name="Search spells by name or ID" Margin="0,10,0,0"/>
        <TextBlock x:Name="SearchHint" Text="Search spell names or an ID. Any rank counts automatically." Style="{StaticResource Hint}" Margin="0,7,0,9"/>
       </StackPanel>
       <ListBox Grid.Row="1" x:Name="SearchResults" SelectionChanged="Picker_Changed" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" ItemContainerStyle="{StaticResource SpellChoiceItem}" TextSearch.TextPath="Name" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Available spells"><ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Label}"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding Image}" Width="30" Height="30" HorizontalAlignment="Left"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Id}" Style="{StaticResource Hint}" FontSize="10"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
       <StackPanel Grid.Row="2" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ADD TO SECTION" Style="{StaticResource Hint}" FontSize="10" Margin="0,0,0,5"/><ComboBox IsSynchronizedWithCurrentItem="False" x:Name="AddTargetChoice" MinHeight="34" AutomationProperties.Name="Section for new spell"/></StackPanel><Button Grid.Column="2" Content="+ Add spell" Click="AddSpell_Click" Padding="8,7" VerticalAlignment="Bottom"/></Grid><Button x:Name="AddAlternativeButton" Content="Add as alternative" Click="AddAlternative_Click" Padding="8,7" Margin="0,10,0,5"/><TextBlock x:Name="AlternativeTarget" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
      </Grid></ScrollViewer></TabItem>
      <TabItem x:Name="DockTab" Header="Button groups"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="DockEditorHost" Margin="0,0,8,0"/></ScrollViewer></TabItem>
     </TabControl></Border>
    </Grid>

   </Grid>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,16,0,0"><DockPanel x:Name="ClickSessionPanel" Visibility="Collapsed" Margin="0,0,0,8">
   <TextBlock x:Name="ClickSessionStatus" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"/>
  </DockPanel><TextBlock x:Name="StatusLabel" Text="Ready" Foreground="{DynamicResource Accent}" TextWrapping="Wrap"/><TextBlock Text="Changes save automatically. Closing settings keeps your overlays running." Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel>
 </Grid></Border>
</Window>
