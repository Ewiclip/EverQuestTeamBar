<Window x:Class="TeamBar.OverlayButtonEditor" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="454" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="Transparent"
        FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/TeamBar;component/SpellOverlayStyles.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <Style TargetType="Button">
    <Setter Property="Padding" Value="9,5"/><Setter Property="MinHeight" Value="28"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Frame" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".48"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Field}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
     <Border x:Name="FieldBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="9,6">
      <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </Window.Resources>
 <Border x:Name="PanelRoot" CornerRadius="9" BorderBrush="{DynamicResource Edge}" BorderThickness="1" Background="{DynamicResource Surface}" Padding="13">
  <DockPanel LastChildFill="True">
   <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
    <Button DockPanel.Dock="Right" Content="×" Width="28" Padding="0" Background="Transparent" FontSize="17"
            ToolTip="Close" AutomationProperties.Name="Close editor" Click="ClosePanel"/>
    <TextBlock x:Name="Heading" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
   </DockPanel>
   <TextBlock x:Name="ErrorMessage" DockPanel.Dock="Bottom" Margin="0,8,0,0" Visibility="Collapsed"
              Foreground="{DynamicResource Feedback}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <Grid>
    <StackPanel x:Name="Body"/>
    <Grid x:Name="IconBrowser" Visibility="Collapsed">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid>
      <TextBox x:Name="IconSearch" AutomationProperties.Name="Search icons by ID, item or spell" TextChanged="IconSearchChanged"/>
      <TextBlock x:Name="IconSearchHint" Text="Search by icon ID or name…" Margin="10,0" VerticalAlignment="Center"
                 Foreground="{DynamicResource Muted}" IsHitTestVisible="False"/>
     </Grid>
     <UniformGrid x:Name="IconCategories" Grid.Row="1" Columns="4" Margin="0,7,0,6"/>
     <TextBlock x:Name="IconStatus" Grid.Row="2" Margin="1,1,0,5" TextWrapping="Wrap" FontSize="12"
                Foreground="{DynamicResource Muted}" AutomationProperties.LiveSetting="Polite"/>
     <ScrollViewer x:Name="IconScroll" Grid.Row="3" MaxHeight="284" HorizontalScrollBarVisibility="Disabled"
                   VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Icon results">
      <UniformGrid x:Name="IconTiles" Columns="4"/>
     </ScrollViewer>
     <DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="False">
      <Button Content="No icon" AutomationProperties.Name="No icon" Padding="7,3" Click="ClearIcon"/>
      <Button Content="EQ folder…" Padding="7,3" Margin="4,0,0,0" AutomationProperties.Name="Choose EverQuest folder"
              ToolTip="Choose the EverQuest installation containing your icons" Click="ChooseIconFolder"/>
      <Button x:Name="NextIconPage" DockPanel.Dock="Right" Content="›" FontSize="16" Width="32" Padding="2" Margin="3,0,0,0"
              AutomationProperties.Name="Next icon page" ToolTip="Next page" Click="NextIcons"/>
      <Button x:Name="PreviousIconPage" DockPanel.Dock="Right" Content="‹" FontSize="16" Width="32" Padding="2"
              AutomationProperties.Name="Previous icon page" ToolTip="Previous page" Click="PreviousIcons"/>
     </DockPanel>
    </Grid>
   </Grid>
  </DockPanel>
 </Border>
</Window>
